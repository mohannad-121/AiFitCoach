# Supabase server credentials (never expose the service role key to Vite)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider. Gemini uses the OpenAI-compatible Gemini endpoint, so chat,
# streaming, tool calls, and image analysis retain the existing behavior.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
# Keep these only if you intentionally want to switch back to OpenAI.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=
CHAT_RESPONSE_MODE=auto

# PayPal Business REST API credentials. Start with sandbox, then switch to live.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLUS_PLAN_ID=
PAYPAL_PRO_PLAN_ID=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8012
ENVIRONMENT=development
